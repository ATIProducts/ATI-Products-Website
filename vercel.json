{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "destination": "https://www.ati-products.com/:path*",
      "permanent": false
    },
    {
      "source": "/adjustastair-specs",
      "destination": "/adjustastairspecs",
      "permanent": true
    },
    {
      "source": "/buying-vs-renting-scaffolding",
      "destination": "/buyingvsrentingscaffolding",
      "permanent": true
    },
    {
      "source": "/choosing-temporary-roof-access",
      "destination": "/choosingtemporaryroofaccess",
      "permanent": true
    },
    {
      "source": "/colorado-construction-supply",
      "destination": "/coloradoconstructionsupply",
      "permanent": true
    },
    {
      "source": "/crm-replacement-for-contractors",
      "destination": "/crmreplacementforcontractors",
      "permanent": true
    },
    {
      "source": "/google-ads-management",
      "destination": "/googleadsmanagement",
      "permanent": true
    },
    {
      "source": "/lead-generation",
      "destination": "/leadgeneration",
      "permanent": true
    },
    {
      "source": "/marketing-channels-for-service-businesses",
      "destination": "/marketingchannelsforservicebusinesses",
      "permanent": true
    },
    {
      "source": "/marketing-hub",
      "destination": "/marketinghub",
      "permanent": true
    },
    {
      "source": "/osha-stairway-requirements",
      "destination": "/oshastairwayrequirements",
      "permanent": true
    },
    {
      "source": "/scaffolding-marketplace",
      "destination": "/scaffoldingmarketplace",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
